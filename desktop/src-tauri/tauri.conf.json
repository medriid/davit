{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "daVIT",
  "version": "1.0.0",
  "identifier": "dev.medriid.davit",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "daVIT", "width": 1180, "height": 780, "minWidth": 860, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'; frame-src asset: http://asset.localhost; object-src asset: http://asset.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPCACHE/previews/**", "$DOWNLOAD/daVIT/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "category": "Education",
    "shortDescription": "VTOP, without the waiting",
    "copyright": "Not affiliated with VIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
